{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golatam/sirenko-seo-aieo-skills/schemas/brief.schema.json",
  "title": "SEO article brief",
  "description": "Выход seo-content-operations (step=brief) в режиме service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_title", "slug", "title", "meta", "audience", "search_intent", "outline", "author_experience", "product_mentions_max", "faq", "internal_links"],
  "properties": {
    "topic_title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "meta": { "type": "string", "minLength": 1, "maxLength": 155 },
    "audience": { "type": "string", "minLength": 1 },
    "search_intent": { "type": "string", "minLength": 1 },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["h2", "points", "sources"],
        "properties": {
          "h2": { "type": "string", "minLength": 1 },
          "points": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sources": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    },
    "author_experience": {
      "type": "array",
      "description": "Только факты об опыте автора из профиля сайта; пусто, если их нет.",
      "items": { "type": "string", "minLength": 1 }
    },
    "product_mentions_max": { "type": "integer", "minimum": 0 },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q"],
        "properties": { "q": { "type": "string", "minLength": 1 } }
      }
    },
    "internal_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "anchor"],
        "properties": {
          "url": { "type": "string", "format": "uri-reference", "minLength": 1 },
          "anchor": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reasons": {
      "type": "array",
      "description": "Чего не хватило для полного брифа (нет источников, нет опыта автора и т. п.).",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
